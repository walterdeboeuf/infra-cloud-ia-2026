# Copy to dev.tfvars (git-ignored) and fill in YOUR values:
#   cp dev.tfvars.example dev.tfvars
project_id            = "my-project-id"
region                = "us-central1"
zone                  = "us-central1-a"
servicio_patron_image = "us-central1-docker.pkg.dev/my-project-id/infra-cloud-template/app:v1"

# Class 5 onward (costs money while it exists):
# enable_gke = true

# Who can reach app_port on the VM (default: anyone). Narrow it for an RPC:
# app_source_ranges = ["<your-ip>/32"]
